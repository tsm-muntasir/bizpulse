NODE_ENV=development
PORT=8080
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/smart-study
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=replace_with_long_random_access_secret
JWT_REFRESH_SECRET=replace_with_long_random_refresh_secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
BCRYPT_SALT_ROUNDS=12
COOKIE_DOMAIN=localhost
CORS_ORIGINS=http://localhost:3000,http://localhost:19006
AI_PROVIDER=openai
AI_API_KEY=replace_with_ai_key
STRIPE_SECRET_KEY=replace_with_stripe_secret
STRIPE_WEBHOOK_SECRET=replace_with_stripe_webhook_secret
BKASH_APP_KEY=replace_with_bkash_app_key
BKASH_APP_SECRET=replace_with_bkash_app_secret
BKASH_USERNAME=replace_with_bkash_username
BKASH_PASSWORD=replace_with_bkash_password
NAGAD_MERCHANT_ID=replace_with_nagad_merchant_id
NAGAD_API_KEY=replace_with_nagad_api_key
